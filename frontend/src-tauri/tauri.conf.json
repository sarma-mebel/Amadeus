{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Amadeus Kurisu",
  "version": "0.17.0",
  "identifier": "com.amadeus.kurisu",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Amadeus Kurisu",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required --use-fake-ui-for-media-stream"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Entertainment",
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/amadeus-backend"],
    "resources": {
      "../dist": "frontend/dist",
      "../../static": "static",
      "../../assets": "assets",
      "../../models/kurisu_voice_onnx": "models/kurisu_voice_onnx"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "installerHooks": "installer-hooks.nsh",
        "languages": ["English"]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg5NjlBQUY3MDVFMzk3QgpSV1I3T1Y1d3I1cVdDSXVUMGQ1bzlpOGV0RytqRnFReDBmSlZ2RituK0JzM0NEZ3J3S0ZveStBaAo=",
      "endpoints": [
        "https://github.com/zxKyouma/Amadeus/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
