<?xml version="1.0" encoding="utf-8"?>
<!-- The backend is self-hosted: on a phone it is typically a plain-HTTP
     server on the LAN (http://192.168.x.x:8000), so cleartext must be
     permitted. HTTPS backends (hosted demos, reverse proxies) work
     unchanged. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
