{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "node ./node_modules/eslint/bin/eslint.js .",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:gpu": "tauri build --features qwen --config src-tauri/tauri.gpu.conf.json",
    "tauri:build:gpu:nobundle": "tauri build --no-bundle --features qwen --config src-tauri/tauri.gpu.conf.json",
    "tauri:build:gpuslim": "tauri build --features qwen --config src-tauri/tauri.gpuslim.conf.json",
    "package:desktop:windows": "powershell -ExecutionPolicy Bypass -File ../scripts/package_desktop_windows.ps1",
    "cap:sync": "npm run build && npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "build:desktop": "tsc -b && vite build --mode desktop",
    "test": "vitest run",
    "test:ci": "node scripts/run-tests.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^6.2.0",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.5",
    "@fontsource/zen-kaku-gothic-new": "^5.2.5",
    "@pixiv/three-vrm": "^3.4.3",
    "@pixiv/three-vrm-animation": "^3.4.3",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.4.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "@eslint/js": "^9.36.0",
    "@gltf-transform/cli": "^4.4.1",
    "@gltf-transform/functions": "^4.4.1",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "vitest": "^4.1.10"
  }
}
